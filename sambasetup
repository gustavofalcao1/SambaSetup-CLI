}

# Check privileges
check_root

# Main Menu
main_menu() {
    while true; do
        show_menu "SambaSetup-CLI - Active Directory Management" \
            "Domain Configuration" \
            "User Management" \
            "Share Management" \
            "Monitoring and Logs" \
            "Backup and Restore" \
            "Advanced Settings"
        
        read -p "$(echo -e "${COLOR_SECONDARY}Select an option:${COLOR_RESET} ")" choice
        
        case $choice in
            1) source "${SCRIPT_DIR}/src/samba.sh";;
            2) source "${SCRIPT_DIR}/src/users.sh";;
            3) source "${SCRIPT_DIR}/src/shares.sh";;
            4) monitoring_menu;;
            5) backup_menu;;
            6) advanced_menu;;
            0) 
                echo -e "\n${COLOR_SUCCESS}Thank you for using SambaSetup-CLI!${COLOR_RESET}"
                exit 0
                ;;
            *) log_message "WARN" "Invalid option";;
        esac
    done
}

# Monitoring Menu
monitoring_menu() {
    while true; do
        show_menu "Monitoring and Logs" \
            "Service Status" \
            "System Logs" \
            "Samba Logs" \
            "Active Connections" \
            "Statistics"
        
        read -p "$(echo -e "${COLOR_SECONDARY}Select an option:${COLOR_RESET} ")" choice
        
        case $choice in
            1) 
                echo -e "\n${COLOR_INFO}Service Status:${COLOR_RESET}"
                systemctl status samba-ad-dc
                read -p "Press ENTER to continue..."
                ;;
            2)
                echo -e "\n${COLOR_INFO}System Logs (Press Ctrl+C to exit):${COLOR_RESET}"
                tail -f "${MAIN_LOG}"
                ;;
            3)
                echo -e "\n${COLOR_INFO}Samba Logs (Press Ctrl+C to exit):${COLOR_RESET}"
                tail -f "${SAMBA_MAIN_LOG}"
                ;;
            4)
                echo -e "\n${COLOR_INFO}Active Connections:${COLOR_RESET}"
                smbstatus
                read -p "Press ENTER to continue..."
                ;;
            5)
                echo -e "\n${COLOR_INFO}Samba Statistics:${COLOR_RESET}"
                samba-tool stats
                read -p "Press ENTER to continue..."
                ;;
            0) break;;
            *) log_message "WARN" "Invalid option";;
        esac
    done
}

# Backup Menu
backup_menu() {
    while true; do
        show_menu "Backup and Restore" \
            "Create Full Backup" \
            "Restore Backup" \
            "List Backups" \
            "Clean Old Backups"
        
        read -p "$(echo -e "${COLOR_SECONDARY}Select an option:${COLOR_RESET} ")" choice
        
        case $choice in
            1) create_backup "${SAMBA_LIB}";;
            2) 
                echo -e "\n${COLOR_INFO}Available backups:${COLOR_RESET}"
                ls -l "${SCRIPT_DIR}/backups/"
                echo ""
                read -p "Enter backup name to restore: " backup_name
                restore_backup "${SCRIPT_DIR}/backups/$backup_name" "${SAMBA_LIB}"
                ;;
            3)
                echo -e "\n${COLOR_INFO}Available backups:${COLOR_RESET}"
                ls -l "${SCRIPT_DIR}/backups/"
                read -p "Press ENTER to continue..."
                ;;
            4)
                if confirm_action "This will delete backups older than 30 days. Continue?"; then
                    find "${SCRIPT_DIR}/backups/" -mtime +30 -delete
                    log_message "INFO" "Old backups cleaned successfully"
                fi
                ;;
            0) break;;
            *) log_message "WARN" "Invalid option";;
        esac
    done
}

# Advanced Menu
advanced_menu() {
    while true; do
        show_menu "Advanced Settings" \
            "Edit smb.conf" \
            "Configure DNS" \
            "Configure Kerberos" \
            "Service Management" \
            "Check Configuration"
        
        read -p "$(echo -e "${COLOR_SECONDARY}Select an option:${COLOR_RESET} ")" choice
        
        case $choice in
            1)
                echo -e "\n${COLOR_INFO}Opening smb.conf in editor...${COLOR_RESET}"
                ${EDITOR:-nano} "${SAMBA_CONF}"
                ;;
            2)
                echo -e "\n${COLOR_INFO}Opening resolv.conf in editor...${COLOR_RESET}"
                ${EDITOR:-nano} "/etc/resolv.conf"
                ;;
            3)
                echo -e "\n${COLOR_INFO}Opening krb5.conf in editor...${COLOR_RESET}"
                ${EDITOR:-nano} "/etc/krb5.conf"
                ;;
            4) service_menu;;
            5)
                echo -e "\n${COLOR_INFO}Checking Samba configuration:${COLOR_RESET}"
                testparm -s
                read -p "Press ENTER to continue..."
                ;;
            0) break;;
            *) log_message "WARN" "Invalid option";;
        esac
    done
}

# Service Menu
service_menu() {
    while true; do
        show_menu "Service Management" \
            "Start Samba AD" \
            "Stop Samba AD" \
            "Restart Samba AD" \
            "Service Status"
        
        read -p "$(echo -e "${COLOR_SECONDARY}Select an option:${COLOR_RESET} ")" choice
        
        case $choice in
            1)
                systemctl start samba-ad-dc
                log_message "INFO" "Samba AD service started"
                ;;
            2)
                systemctl stop samba-ad-dc
                log_message "INFO" "Samba AD service stopped"
                ;;
            3)
                systemctl restart samba-ad-dc
                log_message "INFO" "Samba AD service restarted"
                ;;
            4)
                echo -e "\n${COLOR_INFO}Service Status:${COLOR_RESET}"
                systemctl status samba-ad-dc
                read -p "Press ENTER to continue..."
                ;;
            0) break;;
            *) log_message "WARN" "Invalid option";;
        esac
    done
}

# Start the program
parse_args "$@"
show_startup_logo
log_message "INFO" "Starting SambaSetup-CLI"
check_dependencies
clear
main_menu
